<div class="layout gap--medium">
  <div class="columns gap--medium">
    <div class="column w--auto">
      {% render "weather_icon", icon: icon, size: 64 %}
    </div>
    <div class="column">
      <span class="value text--xxlarge">{{ temperature }}°C</span>
      <span class="label">{{ condition }} · H {{ high }}° L {{ low }}°</span>
    </div>
  </div>

  <div class="grid grid--cols-4 gap--small">
    {% for h in hourly %}
    <div class="item">
      <div class="content">
        {% render "weather_bar", height: h.bar_height %}
        {% render "weather_icon", icon: h.icon, size: 24 %}
        <span class="title title--small">{{ h.time }}</span>
        <span class="description">{{ h.temp }}°</span>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="instance">{{ location }}</span>
</div>
