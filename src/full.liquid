<div class="layout gap--medium">
  <div class="columns gap--large">
    <div class="column w--auto">
      {% render "weather_icon", icon: icon, size: 80 %}
    </div>
    <div class="column">
      <span class="value text--xxxlarge">{{ temperature }}°C</span>
      <span class="label">{{ condition }} · Feels like {{ feels_like }}°C</span>
    </div>
  </div>

  <div class="grid grid--cols-4 gap--medium">
    <div class="item">
      <div class="content">
        <span class="title title--small">High</span>
        <span class="description">{{ high }}°C</span>
      </div>
    </div>
    <div class="item">
      <div class="content">
        <span class="title title--small">Low</span>
        <span class="description">{{ low }}°C</span>
      </div>
    </div>
    <div class="item">
      <div class="content">
        <span class="title title--small">Humidity</span>
        <span class="description">{{ humidity }}%</span>
      </div>
    </div>
    <div class="item">
      <div class="content">
        <span class="title title--small">Wind</span>
        <span class="description">{{ wind_speed }} km/h</span>
      </div>
    </div>
  </div>

  <div class="grid grid--cols-4 gap--medium">
    {% for h in hourly %}
    <div class="item">
      <div class="content">
        {% render "weather_bar", height: h.bar_height %}
        {% render "weather_icon", icon: h.icon, size: 32 %}
        <span class="title title--small">{{ h.time }}</span>
        <span class="description">{{ h.condition }} · {{ h.temp }}°</span>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <span class="instance">{{ location }}</span>
</div>
